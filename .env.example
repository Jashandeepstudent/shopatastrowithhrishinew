# Copy to .env for local development. Never commit .env.
# Local development uses Razorpay TEST keys only. Live keys go only into Netlify environment variables.

# --- Server-side only (Netlify Functions). Never prefix these with VITE_ ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Admin (service account). Only these two fields, not the whole JSON (Netlify 4 KB env limit).
# FIREBASE_PRIVATE_KEY keeps its "\n" sequences as written in the service account JSON.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Comma-separated Firebase Auth UIDs allowed into the admin panel (in addition to the `admin` custom claim).
ADMIN_UIDS=

# --- Public frontend config (bundled into the site; must not contain secrets) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_ADS_CONVERSION_LABEL=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_META_PIXEL_ID=
VITE_SITE_URL=

# --- Local Firebase Emulator Suite (development only; leave unset in Netlify) ---
# Set to "true" to point the frontend at the local Auth/Firestore emulators.
# When using the emulators, also set VITE_FIREBASE_PROJECT_ID=demo-astro-hrishi
VITE_USE_FIREBASE_EMULATOR=
# Point the functions (Firebase Admin SDK) at the emulators. Never set these on Netlify.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

VITE_GTM_ID=
